# Copie para .env na pasta do trabalho e preencha SÓ a chave do provedor escolhido.
# O .env não deve ir para o git (confira o .gitignore). Nunca cole a chave no chat.

# OpenAI (gpt-image-2): https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini (gemini-2.5-flash-image): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Stability AI (Stable Image Core): https://platform.stability.ai/account/keys
STABILITY_API_KEY=
